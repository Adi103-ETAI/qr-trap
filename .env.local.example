# Copy this file to `.env.local` and fill in your values.
# Everything below is required unless marked "optional".

# --- Database ---
# Local dev: SQLite file. Production: Supabase Postgres URL.
DATABASE_URL=file:./db/local.db
# DATABASE_URL=postgresql://user:password@host:port/dbname

# --- App URLs ---
# Where your app runs. Use your real URL in production.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Secrets ---
# Generate random strings with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-string
ADMIN_SECRET=choose-an-admin-password

# --- Optional: Google sign-in (leave blank to use demo flow) ---
# Get these from Google Cloud Console > APIs & Services > Credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: Resend (real email delivery) ---
# Sign up at resend.com and create an API key.
# RESEND_API_KEY=
