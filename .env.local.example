# ---- Sandbox demo .env.local.example ----
# Copy to `.env.local` and fill in for production usage.

# SQLite file path (sandbox). For Supabase, replace with `postgresql://...`.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=cyberclub-nextauth-secret-demo-2026-please-change

# Public NextAuth URL (where the app is hosted)
NEXTAUTH_URL=http://localhost:3000

# Public app URL (used to build simulation links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin dashboard password (used by Credentials + admin login flow)
ADMIN_SECRET=cyberclub-admin-demo-2026

# Optional — real Google OAuth (production):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional — Resend API key (production email):
# RESEND_API_KEY=

# Production DB (Supabase Postgres):
# DATABASE_URL=postgresql://user:pass@host:port/dbname
