# Copy this file to `.env.local` and fill in your values.
# Everything below is required unless marked "optional".

# --- Supabase ---
# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/publishable key (safe for client — respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only — bypasses RLS, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database ---
# Supabase Postgres connection string.
# Dashboard → Settings → Database → Connection string → URI (use the pooler URL)
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- App URLs ---
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Secrets ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-string
ADMIN_SECRET=choose-an-admin-password

# --- Resend (email delivery) ---
# Get this from Resend Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender email address. Options:
#   - Testing: 'Cyber Club <onboarding@resend.dev>' (free, no setup)
#   - Production: 'Cyber Club <no-reply@yourdomain.com>' (requires domain verification)
RESEND_FROM_EMAIL=Cyber Club <onboarding@resend.dev>
